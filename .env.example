# First-run admin bootstrap (set your own in .env.local — gitignored).
# If ADMIN_PASSWORD is left unset, a random password is generated and printed
# once to the server console on first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Supabase (when migrating off local PGlite) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=postgresql://...

# PromptPay QR (สร้าง QR ให้ลูกค้าสแกนจ่ายตามยอดบิล)
# เลขพร้อมเพย์ของร้าน: เบอร์มือถือ 10 หลัก หรือ เลขบัตร ปชช./ผู้เสียภาษี 13 หลัก
PROMPTPAY_ID=
PROMPTPAY_NAME=Lab Parfumo
